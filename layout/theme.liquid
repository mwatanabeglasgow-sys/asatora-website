<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#F1EBDF">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}" type="image/png">
  {%- endif -%}

  {%- comment -%} Title + meta SEO §14 {%- endcomment -%}
  <title>{% if page_title %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  {%- comment -%} Open Graph / Twitter §14 {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | default: shop.name }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if settings.share_image -%}<meta property="og:image" content="{{ settings.share_image | image_url: width: 1200 }}">{%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  {%- comment -%} Fonts: preconnect + subset, swap (no CLS) §13 §14 {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&family=Shippori+Mincho:wght@400;500;600&family=Noto+Sans+JP:wght@400;500&display=swap">

  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- comment -%} schema.org Organization site-wide §14 {%- endcomment -%}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}{% if settings.logo %},"logo":{{ settings.logo | image_url: width: 400 | prepend: "https:" | json }}{% endif %}}
  </script>

  {%- comment -%} Plausible analytics §14 — domain set in theme settings {%- endcomment -%}
  {%- if settings.plausible_domain != blank -%}
    <script defer data-domain="{{ settings.plausible_domain }}" src="https://plausible.io/js/script.tagged-events.js"></script>
    <script>window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}</script>
  {%- endif -%}

  <script>
    window.AsatoraMoneyFormat = {{ shop.money_format | json }};
    window.AsatoraStrings = {
      cartEmpty: {{ 'cart.empty' | t | json }},
      cartShop: {{ 'cart.shop' | t | json }},
      cartRemove: {{ 'cart.remove' | t | json }}
    };
  </script>
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  <span class="grain" aria-hidden="true"></span>
  <a class="visually-hidden" href="#main">{{ 'a11y.skip_to_content' | t }}</a>

  {%- sections 'header-group' -%}

  <main id="main">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}

  {%- render 'cart-drawer' -%}

  {{ 'asatora.js' | asset_url | script_tag }}
</body>
</html>
