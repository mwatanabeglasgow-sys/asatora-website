{%- comment -%} Hero §11 — one shot, one line, one CTA, orchestrated load + seal press §8 {%- endcomment -%}
<section class="hero" data-load>
  <div class="hero__bg">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2000 }}"
           srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
           sizes="100vw" alt="{{ section.settings.image.alt | escape | default: 'Asatora matcha tin on cream' }}"
           width="2000" height="1333" fetchpriority="high">
    {%- else -%}
      {%- comment -%} COMP PLACEHOLDER — confirm with Adisa: hero shot of the tin on cream {%- endcomment -%}
      <img src="{{ 'comp-hero.png' | asset_url }}" alt="Asatora matcha tin on cream (comp)" width="1376" height="768" fetchpriority="high">
    {%- endif -%}
  </div>

  <div class="container hero__inner stack-lg">
    <p class="overline reveal-hero">{{ section.settings.overline | default: 'hero.overline' | t }}</p>
    <h1 class="display reveal-hero">{{ section.settings.heading | default: 'hero.heading' | t }}</h1>
    <div class="reveal-hero">
      <a class="btn btn--primary" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_label | default: 'hero.cta' | t }}
      </a>
    </div>
    <div class="hero__seal">{%- render 'seal' -%}</div>
  </div>

  <span class="hero__cue" aria-hidden="true">{{ 'hero.scroll' | t }}</span>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (tin on cream)" },
    { "type": "text", "id": "overline", "label": "Overline" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Single-origin matcha. Shibushi, Kagoshima." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop the first harvest" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
