{%- comment -%} Generic page (richtext) {%- endcomment -%}
<section class="section">
  <div class="container stack" style="max-width:54rem;padding-top:var(--space-12)">
    <h1>{{ page.title }}</h1>
    <div class="rte stack">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
