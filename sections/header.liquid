{%- comment -%}
  Header §9 §11 — centered logo, ≤4 nav items, transparent over hero,
  condensing to solid warm bar on scroll, cart with live count, JP/EN toggle.
{%- endcomment -%}
{%- assign over_hero = false -%}
{%- if request.page_type == 'index' and settings.header_over_hero -%}{%- assign over_hero = true -%}{%- endif -%}

<header class="header{% if over_hero %} header--over-hero{% endif %}" data-header>
  <nav class="header__nav" aria-label="{{ 'a11y.primary_nav' | t }}">
    {%- for link in section.settings.menu.links limit: 4 -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <button class="menu-btn" type="button" data-menu-open style="justify-self:start" aria-label="{{ 'a11y.primary_nav' | t }}" aria-expanded="false" aria-controls="mobile-nav">
    {%- render 'icon', icon: 'menu' -%}
  </button>

  <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} — home">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="100" height="38">
    {%- else -%}
      {%- comment -%} PLACEHOLDER — confirm with Adisa: tiger + mountain roundel / wordmark lockup {%- endcomment -%}
      <span style="font-family:var(--font-jp-head)">朝虎</span><span style="letter-spacing:.18em;font-size:1rem">ASATORA</span>
    {%- endif -%}
  </a>

  <div class="header__actions">
    {%- comment -%} JP/EN toggle §11 (bilingual launch) {%- endcomment -%}
    {%- if localization.available_languages.size > 1 -%}
      <div class="lang-toggle">
        {%- form 'localization' -%}
          {%- for lang in localization.available_languages -%}
            <button type="submit" name="locale_code" value="{{ lang.iso_code }}"
                    {% if lang.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}>{{ lang.iso_code | slice: 0, 2 | upcase }}</button>
            {%- unless forloop.last %}<span aria-hidden="true">·</span>{% endunless -%}
          {%- endfor -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <button class="cart-toggle" type="button" data-cart-open aria-label="{{ 'cart.title' | t }}">
      {%- render 'icon', icon: 'cart' -%}
      <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
    </button>
  </div>
</header>

{%- comment -%} Mobile nav panel (≤4 items) {%- endcomment -%}
<nav class="mobile-nav" id="mobile-nav" data-mobile-nav aria-label="{{ 'a11y.primary_nav' | t }}" hidden>
  {%- for link in section.settings.menu.links limit: 4 -%}
    <a href="{{ link.url }}">{{ link.title }}</a>
  {%- endfor -%}
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu (max 4 shown)", "default": "main-menu" }
  ]
}
{% endschema %}
