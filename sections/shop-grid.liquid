{%- comment -%} Shop grid §11 — clean SKU cards with whitespace {%- endcomment -%}
{%- assign collection = section.settings.collection -%}
<section class="section" id="shop">
  <div class="container stack-lg">
    <div style="text-align:center">
      <p class="overline">{{ 'shop.overline' | t }}</p>
      <h2>{{ section.settings.heading | default: 'shop.heading' | t }}</h2>
    </div>
    <div class="shop-grid">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} COMP PLACEHOLDER — assign a collection to replace these {%- endcomment -%}
        {%- assign comp_imgs = 'comp-tin.png,comp-bag.png' | split: ',' -%}
        {%- assign comp_names = 'Signature Tin · 30g,Refill Bag · 30g' | split: ',' -%}
        {%- assign comp_prices = '¥—,¥—' | split: ',' -%}
        {%- for img in comp_imgs -%}
          <article class="card">
            <span class="card__frame"><img src="{{ img | asset_url }}" alt="{{ comp_names[forloop.index0] }} (comp)" width="928" height="1152" loading="lazy"></span>
            <div class="card__row"><h3 class="card__name">{{ comp_names[forloop.index0] }}</h3><span class="price">{{ comp_prices[forloop.index0] }}</span></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ],
  "presets": [ { "name": "Shop grid" } ]
}
{% endschema %}
