{%- comment -%} The ritual §11 — 3 simple visual steps, ≤4 words each {%- endcomment -%}
<section class="section section--paper-deep">
  <div class="container stack-lg">
    <div style="text-align:center">
      <p class="overline">{{ 'ritual.overline' | t }}</p>
      <h2>{{ section.settings.heading | default: 'ritual.heading' | t }}</h2>
    </div>
    <div class="ritual">
      {%- for block in section.blocks -%}
        <div class="ritual__step reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 180 }}" alt="{{ block.settings.label | escape }}" width="90" height="90" loading="lazy">
          {%- else -%}
            <p class="num"></p>
          {%- endif -%}
          <p class="display" style="font-size:var(--step-h3)">{{ block.settings.label }}</p>
          {%- if block.settings.note != blank -%}<p class="small" style="color:var(--text-soft)">{{ block.settings.note }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The ritual",
  "max_blocks": 4,
  "settings": [ { "type": "text", "id": "heading", "label": "Heading" } ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Icon / photo" },
      { "type": "text", "id": "label", "label": "Label (≤ 4 words)", "default": "Scoop" },
      { "type": "text", "id": "note", "label": "Note" }
    ] }
  ],
  "presets": [
    { "name": "The ritual", "blocks": [
      { "type": "step", "settings": { "label": "Scoop" } },
      { "type": "step", "settings": { "label": "Whisk" } },
      { "type": "step", "settings": { "label": "Pour" } }
    ] }
  ]
}
{% endschema %}
