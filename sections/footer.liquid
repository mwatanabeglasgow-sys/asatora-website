{%- comment -%} Footer §11 — quiet, faint line-art backdrop, nav, brand mark, JP/EN {%- endcomment -%}
<footer class="footer">
  {%- render 'lineart' -%}
  <div class="container">
    <div class="footer__grid">
      <div>
        <p class="footer__brand">{% if settings.logo_light %}<img src="{{ settings.logo_light | image_url: width: 240 }}" alt="{{ shop.name }}" style="height:2.4rem;width:auto">{% else %}朝虎{% endif %}</p>
        <p class="small" style="max-width:32ch;margin-top:1rem;opacity:.8">{{ section.settings.tagline | default: 'footer.tagline' | t }}</p>
        <div style="margin-top:1.5rem">{%- render 'seal' -%}</div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu != blank -%}
          <nav {{ block.shopify_attributes }} aria-label="{{ block.settings.heading }}">
            <h4>{{ block.settings.heading }}</h4>
            <ul role="list" class="stack" style="--space-4:.5rem">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</span>
      <span>{{ 'footer.from_japan' | t }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    { "name": "Footer", "blocks": [ { "type": "menu" }, { "type": "menu" } ] }
  ]
}
{% endschema %}
