{%- comment -%} SKU card §9. Param: product {%- endcomment -%}
<article class="card reveal">
  <a class="card__frame" href="{{ product.url }}" aria-label="{{ product.title }}">
    {%- if product.featured_media -%}
      <img src="{{ product.featured_media | image_url: width: 700 }}"
           srcset="{{ product.featured_media | image_url: width: 400 }} 400w, {{ product.featured_media | image_url: width: 700 }} 700w, {{ product.featured_media | image_url: width: 1000 }} 1000w"
           sizes="(min-width:640px) 40vw, 90vw"
           alt="{{ product.featured_media.alt | escape | default: product.title }}" width="700" height="875" loading="lazy">
    {%- else -%}
      {%- comment -%} COMP PLACEHOLDER product image {%- endcomment -%}
      <img src="{{ 'comp-tin.png' | asset_url }}" alt="{{ product.title }} (comp)" width="928" height="1152" loading="lazy">
    {%- endif -%}
  </a>
  <div class="card__row">
    <h3 class="card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <span class="price">{{ product.price | money }}</span>
  </div>
  {%- if product.metafields.custom.short_note -%}
    <p class="small" style="color:var(--text-soft)">{{ product.metafields.custom.short_note }}</p>
  {%- endif -%}
  {%- form 'product', product, data-add-to-cart: '' -%}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <button type="submit" class="btn btn--primary btn--block" {% unless product.available %}disabled{% endunless %}>
      <span class="btn__spinner"></span>
      <span class="btn__label">{% if product.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</span>
    </button>
  {%- endform -%}
</article>
